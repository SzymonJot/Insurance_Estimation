rec_smoke_interaction_ns <- recipe(
charges ~ smoker + bmi + age + sex + region + children,
data = df
) |>
step_log(charges) |>
step_mutate(bmi_30 = if_else(bmi >= 30, "ge30", "lt30")) |>
step_mutate(bmi_30 = factor(bmi_30, levels = c("lt30","ge30"))) |>
step_dummy(all_nominal_predictors()) |>
step_interact(terms = ~ starts_with("smoker_") : starts_with("bmi_30_")) |>
step_normalize(all_numeric_predictors())
lm_spec      <- linear_reg() %>% set_engine("lm")
robust_spec  <- linear_reg() %>% set_engine("rlm")
lm_spec      <- linear_reg() %>% set_engine("lm")
robust_spec  <- linear_reg() %>% set_engine("rlm")
lm_spec      <- linear_reg() %>% set_engine("lm")
ridge_spec   <- linear_reg(penalty = tune(), mixture = 0) %>% set_engine("glmnet")
rf_spec <- rand_forest(mtry = tune(), min_n = tune(), trees = 1000) %>%
set_engine("ranger") %>% set_mode("regression")
xgb_spec <- boost_tree(
trees = 1000, learn_rate = tune(),
tree_depth = tune(), min_n = tune(), loss_reduction = tune()
) %>% set_engine("xgboost") %>% set_mode("regression")
models_list <- list(
lm     = lm_spec,
ridge  = ridge_spec,
rf     = rf_spec,
xgb    = xgb_spec
)
library(workflowsets)
library(dials)
ridge_grid <- grid_regular(penalty(range = c(-4, 1)), levels = 20)  # 10^-4 … 10^1
rf_grid <- grid_latin_hypercube(
mtry(range = c(2L, 20L)),   # adjust upper bound if you know ~#predictors
min_n(),
size = 20
)
xgb_grid <- grid_latin_hypercube(
learn_rate(), tree_depth(), min_n(), loss_reduction(),
size = 25
)
# Attach per-workflow options by model id
wfs2 <- wfs |>
option_add(id = ".*_ridge", grid = ridge_grid) |>
option_add(id = ".*_rf",    grid = rf_grid)    |>
option_add(id = ".*_xgb",   grid = xgb_grid)
wfs <- workflow_set( preproc = recipes_list, models = models_list, cross = TRUE )
recipes_list <- list(
base = rec_base,
smoke_inter = rec_smoke_interaction,
smoke_inter_ns = rec_smoke_interaction_ns,
smoke_inter_ns_bmi = rec_smoke_interaction_ns_bmi
)
