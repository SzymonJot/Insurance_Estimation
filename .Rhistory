plot(fit, res, col = cols, pch = 16,
xlab = "Fitted values", ylab = "Residuals",
main = "Residuals vs Fitted by smoking status")
abline(h = 0, lty = 2)
legend("topright",
legend = c("Smoker", "Non-smoker"),
col = c("tomato", "steelblue"), pch = 16, bty = "n")
